SOLO_AGENT_APP_NAME=Solo Agent
SOLO_AGENT_ENVIRONMENT=development
SOLO_AGENT_HOST=127.0.0.1
SOLO_AGENT_PORT=8000
SOLO_AGENT_RELOAD=true
SOLO_AGENT_WORKSPACE_ROOT=.
SOLO_AGENT_DATABASE_URL=sqlite+aiosqlite:///./data/solo_agent.sqlite3

# 可选值：ollama、openai、deepseek
SOLO_AGENT_PROVIDER=ollama
SOLO_AGENT_MODEL=llama3.1
SOLO_AGENT_BASE_URL=http://localhost:11434
# 使用 openai 或 deepseek 时填写 API Key；使用 ollama 时通常留空
SOLO_AGENT_API_KEY=

SOLO_AGENT_TEMPERATURE=0.2
SOLO_AGENT_PLAN_MAX_TOKENS=500
SOLO_AGENT_RESPONSE_MAX_TOKENS=1400
SOLO_AGENT_MAX_TOOL_CALLS=3
SOLO_AGENT_MEMORY_ENABLED=true
SOLO_AGENT_CONVERSATION_HISTORY_ENABLED=true
